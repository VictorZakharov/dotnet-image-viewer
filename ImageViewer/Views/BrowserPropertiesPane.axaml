<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ImageViewer.ViewModels"
             x:Class="ImageViewer.Views.BrowserPropertiesPane"
             x:DataType="vm:BrowserViewModel"
             Width="320"
             Background="#162038"
             IsVisible="{Binding ShowExifPane}">
  <Border BorderBrush="#2a3858" BorderThickness="1,0,0,0">
    <ScrollViewer>
      <StackPanel Margin="20,18" Spacing="6">
        <Grid Margin="0,0,0,12">
          <TextBlock Text="Properties" Foreground="#e7eef9"
                     FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
          <Button HorizontalAlignment="Right" Padding="6,2" MinHeight="0"
                  FontSize="11" Content="&#x2715;"
                  Command="{Binding ToggleExifPaneCommand}"/>
        </Grid>

        <TextBlock Text="Select a media file to view its properties"
                   Foreground="#5f7494" FontSize="11" FontStyle="Italic"
                   TextWrapping="Wrap" IsVisible="{Binding !HasExifPaneData}"/>

        <StackPanel Spacing="6" IsVisible="{Binding HasExifPaneData}">
          <TextBlock Text="{Binding ExifFileName}" Foreground="#e7eef9"
                     FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding ExifFolder}" Foreground="#8fa1c0"
                     FontSize="11" TextWrapping="Wrap"/>

          <Border Height="1" Background="#2a3858" Margin="0,10"/>

          <Grid IsVisible="{Binding ExifMetadata.DimensionsSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="Dimensions" Foreground="#8fa1c0" FontSize="11" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding ExifMetadata.DimensionsSummary}" Foreground="#dde6f5"
                       FontSize="12" HorizontalAlignment="Right"/>
          </Grid>
          <Grid IsVisible="{Binding ExifMetadata.FileSizeSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="Size" Foreground="#8fa1c0" FontSize="11" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding ExifMetadata.FileSizeSummary}" Foreground="#dde6f5"
                       FontSize="12" HorizontalAlignment="Right"/>
          </Grid>
          <Grid IsVisible="{Binding ExifMetadata.FileCreatedAtSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="Created" Foreground="#8fa1c0" FontSize="11" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding ExifMetadata.FileCreatedAtSummary}" Foreground="#dde6f5"
                       FontSize="11" HorizontalAlignment="Right"/>
          </Grid>
          <Grid IsVisible="{Binding ExifMetadata.FileModifiedAtSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="Modified" Foreground="#8fa1c0" FontSize="11" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding ExifMetadata.FileModifiedAtSummary}" Foreground="#dde6f5"
                       FontSize="11" HorizontalAlignment="Right"/>
          </Grid>
          <Grid IsVisible="{Binding ExifMetadata.FileAccessedAtSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="Accessed" Foreground="#8fa1c0" FontSize="11" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding ExifMetadata.FileAccessedAtSummary}" Foreground="#dde6f5"
                       FontSize="11" HorizontalAlignment="Right"/>
          </Grid>

          <Border Height="1" Background="#2a3858" Margin="0,10"
                  IsVisible="{Binding HasAnyExifData}"/>

          <StackPanel Spacing="4" IsVisible="{Binding HasAnyExifData}">
            <TextBlock Text="{Binding ExifMetadata.CameraSummary}" Foreground="#dde6f5"
                       FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                       IsVisible="{Binding ExifMetadata.CameraSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock Text="{Binding ExifMetadata.Lens}" Foreground="#b3c1dd"
                       FontSize="11" TextWrapping="Wrap"
                       IsVisible="{Binding ExifMetadata.Lens, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock Text="{Binding ExifMetadata.ExposureSummary}" Foreground="#dde6f5"
                       FontSize="12" Margin="0,4,0,0"
                       IsVisible="{Binding ExifMetadata.ExposureSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <Grid IsVisible="{Binding ExifMetadata.TakenAtSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Text="Date taken" Foreground="#8fa1c0" FontSize="11" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding ExifMetadata.TakenAtSummary}" Foreground="#dde6f5"
                         FontSize="11" HorizontalAlignment="Right"/>
            </Grid>
          </StackPanel>

          <TextBlock Text="No camera metadata" Foreground="#5f7494"
                     FontSize="11" FontStyle="Italic" Margin="0,8,0,0"
                     IsVisible="{Binding !HasAnyExifData}"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
