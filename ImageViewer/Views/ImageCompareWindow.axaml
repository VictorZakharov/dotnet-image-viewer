<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:ImageViewer.Controls"
        xmlns:views="using:ImageViewer.Views"
        xmlns:vm="using:ImageViewer.ViewModels"
        x:Class="ImageViewer.Views.ImageCompareWindow"
        x:DataType="vm:ImageCompareViewModel"
        Title="Compare images"
        Icon="/Assets/ImageViewer.png"
        Width="1320" Height="800" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#080e1a">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Border Background="#18243d" Padding="16,10">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="Compare images" Foreground="#f3f7ff"
                     FontSize="19" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding CandidateSummary}" Foreground="#8fa6ca"
                     FontSize="11" VerticalAlignment="Center"/>
          <TextBlock Text="Active:" Foreground="#6f86aa" Margin="12,0,0,0"
                     VerticalAlignment="Center"/>
          <TextBlock Text="{Binding ActiveCandidate.FileName}" Foreground="#dce8f9"
                     FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7">
          <ToggleButton x:Name="SyncToggle" Content="Synchronized"
                        IsChecked="{Binding IsSynchronized, Mode=TwoWay}"
                        Click="OnSynchronizationChanged" Padding="11,5"/>
          <Button Content="Fit" Click="OnFit" Padding="12,5"/>
          <Button Content="100%" Click="OnActualSize" Padding="12,5"/>
          <Button x:Name="BlinkButton" Content="Blink / alternate"
                  IsEnabled="{Binding CanBlink}" Click="OnBlink" Padding="12,5"/>
          <Button Content="Exit blink" IsVisible="{Binding IsBlinking}"
                  Click="OnExitBlink" Padding="10,5"/>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="#111a2d" Padding="16,7"
            BorderBrush="#2a3858" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="7">
        <Button Content="Pick" Click="OnPickActive" Padding="12,5"/>
        <Button Grid.Column="1" Content="Reject" Click="OnRejectActive" Padding="12,5"/>
        <Button Grid.Column="2" Content="Keep active, reject others"
                Click="OnKeepActive" Padding="13,5"/>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="3" Margin="10,0,0,0">
          <TextBlock Text="Rating:" Foreground="#8fa1c0" VerticalAlignment="Center"/>
          <Button Content="0" Tag="0" Click="OnSetRating" Padding="7,4"/>
          <Button Content="1" Tag="1" Click="OnSetRating" Padding="7,4"/>
          <Button Content="2" Tag="2" Click="OnSetRating" Padding="7,4"/>
          <Button Content="3" Tag="3" Click="OnSetRating" Padding="7,4"/>
          <Button Content="4" Tag="4" Click="OnSetRating" Padding="7,4"/>
          <Button Content="5" Tag="5" Click="OnSetRating" Padding="7,4"/>
        </StackPanel>
        <Button Grid.Column="4" Content="Recycle rejected..."
                IsEnabled="{Binding HasRejected}" Click="OnDeleteRejected" Padding="13,5"/>
        <TextBlock Grid.Column="5"
                   Text="Arrows: active · wheel: zoom · drag: pan · F: fit · A: 100% · B: blink · P/X: pick/reject"
                   Foreground="#62789c" FontSize="9" VerticalAlignment="Center"
                   HorizontalAlignment="Right" Margin="12,0"/>
        <Button Grid.Column="6" Content="Close" Click="OnClose" Padding="14,5"/>
      </Grid>
    </Border>

    <Grid Grid.Row="2" Margin="6">
      <ItemsControl x:Name="CandidateItems" ItemsSource="{Binding Candidates}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="{Binding Rows}" Columns="{Binding Columns}"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:CompareCandidateViewModel">
            <views:ImageCompareCellView/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border x:Name="BlinkOverlay" IsVisible="{Binding IsBlinking}"
              Background="#050912" BorderBrush="#45a9ff" BorderThickness="2"
              CornerRadius="5" Margin="3">
        <Grid>
          <controls:ZoomPanImage x:Name="BlinkImage"
                                 ViewportChanged="OnBlinkViewportChanged"/>
          <Border Background="#d916233b" CornerRadius="3" Padding="10,5"
                  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12">
            <TextBlock x:Name="BlinkLabel" Foreground="#eef5ff"
                       FontSize="11" FontWeight="SemiBold"/>
          </Border>
          <TextBlock Text="Press B or Space to alternate · Esc to exit blink"
                     Foreground="#d7e5f8" Background="#c916233b"
                     Padding="10,5" HorizontalAlignment="Center"
                     VerticalAlignment="Bottom" Margin="0,0,0,12"/>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="3" Background="#18243d" Padding="14,7"
            BorderBrush="#2a3858" BorderThickness="0,1,0,0">
      <TextBlock Text="{Binding StatusText}" Foreground="#99adcc" FontSize="10"/>
    </Border>
  </Grid>
</Window>
