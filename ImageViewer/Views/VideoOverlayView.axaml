<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ImageViewer.ViewModels"
             x:Class="ImageViewer.Views.VideoOverlayView"
             x:DataType="vm:ViewerViewModel"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Background="Transparent">
  <Grid>
    <Border HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#d90a1226"
            CornerRadius="5"
            Padding="18,10"
            IsVisible="{Binding IsVideoLoading}"
            IsHitTestVisible="False">
      <TextBlock Text="Opening video..." Foreground="#dde6f5" FontSize="13"/>
    </Border>

    <Border HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#e63c1420"
            BorderBrush="#ff7b8e"
            BorderThickness="1"
            CornerRadius="5"
            Padding="18,10"
            IsVisible="{Binding PlaybackError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
            IsHitTestVisible="False">
      <TextBlock Text="{Binding PlaybackError}"
                 Foreground="#ffd7de" FontSize="13" TextWrapping="Wrap"
                 MaxWidth="520"/>
    </Border>

    <!-- Match the image tool rail while keeping playback controls in the
         existing bottom bar. Menus are populated from the current VLC media. -->
    <Border HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Margin="12,0,0,78"
            Padding="5"
            Background="#e6121c32"
            BorderBrush="#344665"
            BorderThickness="1"
            CornerRadius="7"
            IsVisible="{Binding ShowVideoTools}">
      <Border.Styles>
        <Style Selector="Button.viewer-tool">
          <Setter Property="Width" Value="42"/>
          <Setter Property="Height" Value="42"/>
          <Setter Property="Padding" Value="0"/>
          <Setter Property="FontSize" Value="19"/>
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="BorderThickness" Value="0"/>
          <Setter Property="CornerRadius" Value="4"/>
          <Setter Property="FocusAdorner" Value="{x:Null}"/>
        </Style>
        <Style Selector="Button.viewer-tool:pointerover">
          <Setter Property="Background" Value="#304565"/>
        </Style>
        <Style Selector="Path.viewer-tool-icon">
          <Setter Property="Width" Value="21"/>
          <Setter Property="Height" Value="21"/>
          <Setter Property="Stretch" Value="Uniform"/>
          <Setter Property="Fill" Value="Transparent"/>
          <Setter Property="Stroke" Value="#e7eef9"/>
          <Setter Property="StrokeThickness" Value="1.8"/>
          <Setter Property="StrokeLineCap" Value="Round"/>
          <Setter Property="StrokeJoin" Value="Round"/>
        </Style>
        <Style Selector="Button.viewer-tool:pointerover Path.viewer-tool-icon">
          <Setter Property="Stroke" Value="#71bdff"/>
        </Style>
      </Border.Styles>
      <StackPanel Spacing="3">
        <Button Classes="viewer-tool"
                Click="OnSubtitleToolsClicked"
                IsEnabled="{Binding VideoTools.CanManageSubtitles}"
                AutomationProperties.Name="Subtitle tracks and external subtitles"
                ToolTip.Tip="Subtitles">
          <Path Classes="viewer-tool-icon"
                Data="M 3,6 C 3,4.9 3.9,4 5,4 L 19,4 C 20.1,4 21,4.9 21,6 L 21,18 C 21,19.1 20.1,20 19,20 L 5,20 C 3.9,20 3,19.1 3,18 Z M 10,10 C 9.4,9.3 8.7,9 8,9 C 6.3,9 5,10.3 5,12 C 5,13.7 6.3,15 8,15 C 8.7,15 9.4,14.7 10,14 M 19,10 C 18.4,9.3 17.7,9 17,9 C 15.3,9 14,10.3 14,12 C 14,13.7 15.3,15 17,15 C 17.7,15 18.4,14.7 19,14"/>
        </Button>
        <Button Classes="viewer-tool"
                Click="OnAudioToolsClicked"
                IsEnabled="{Binding VideoTools.HasAudioTracks}"
                AutomationProperties.Name="Audio tracks"
                ToolTip.Tip="Audio track">
          <Path Classes="viewer-tool-icon"
                Data="M 4,13 L 4,11 C 4,6.6 7.6,3 12,3 C 16.4,3 20,6.6 20,11 L 20,13 M 4,13 C 4,11.9 4.9,11 6,11 L 7,11 L 7,19 L 6,19 C 4.9,19 4,18.1 4,17 Z M 20,13 C 20,11.9 19.1,11 18,11 L 17,11 L 17,19 L 18,19 C 19.1,19 20,18.1 20,17 Z"/>
        </Button>
        <Button Classes="viewer-tool"
                Click="OnPlaybackSpeedClicked"
                IsEnabled="{Binding VideoTools.CanChangePlaybackSpeed}"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                AutomationProperties.Name="Playback speed"
                ToolTip.Tip="Playback speed">
          <TextBlock Text="{Binding VideoTools.PlaybackRateLabel}"
                     Foreground="#e7eef9"
                     FontSize="11"
                     FontWeight="SemiBold"/>
        </Button>
        <Border Height="1" Background="#344665" Margin="4,2"/>
        <Button Classes="viewer-tool"
                Click="OnVideoInfoClicked"
                AutomationProperties.Name="Show video information"
                ToolTip.Tip="Show video information">
          <Path Classes="viewer-tool-icon"
                Data="M 12,3 A 9,9 0 1 0 12,21 A 9,9 0 1 0 12,3 M 12,11 L 12,17 M 12,7 L 12,7.1"/>
        </Button>
      </StackPanel>
    </Border>

    <Border IsVisible="{Binding ShowExifOverlay}"
            Background="#ee0e1830"
            Width="320"
            Margin="0,0,0,78"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            Padding="22,56,22,24">
      <ScrollViewer>
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding FileNameDisplay}"
                     Foreground="#e7eef9" FontSize="14" FontWeight="SemiBold"
                     TextWrapping="Wrap"/>
          <TextBlock Text="{Binding FolderDisplay}"
                     Foreground="#8fa1c0" FontSize="11"
                     TextWrapping="Wrap"/>

          <Border Height="1" Background="#2a3858" Margin="0,10"/>

          <Grid>
            <TextBlock Text="Duration" Foreground="#8fa1c0" FontSize="11" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding DurationLabel}"
                       Foreground="#dde6f5" FontSize="12" HorizontalAlignment="Right"/>
          </Grid>
          <Grid IsVisible="{Binding Metadata.FileSizeSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="Size" Foreground="#8fa1c0" FontSize="11" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Metadata.FileSizeSummary}"
                       Foreground="#dde6f5" FontSize="12" HorizontalAlignment="Right"/>
          </Grid>
          <Grid IsVisible="{Binding Metadata.FileCreatedAtSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="Created" Foreground="#8fa1c0" FontSize="11" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Metadata.FileCreatedAtSummary}"
                       Foreground="#dde6f5" FontSize="11" HorizontalAlignment="Right"/>
          </Grid>
          <Grid IsVisible="{Binding Metadata.FileModifiedAtSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="Modified" Foreground="#8fa1c0" FontSize="11" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Metadata.FileModifiedAtSummary}"
                       Foreground="#dde6f5" FontSize="11" HorizontalAlignment="Right"/>
          </Grid>
          <Grid IsVisible="{Binding Metadata.FileAccessedAtSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="Accessed" Foreground="#8fa1c0" FontSize="11" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Metadata.FileAccessedAtSummary}"
                       Foreground="#dde6f5" FontSize="11" HorizontalAlignment="Right"/>
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Border Background="#f20a1226"
            BorderBrush="#2a3858"
            BorderThickness="0,1,0,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            Height="78">
      <Border.Styles>
        <Style Selector="Button.video-control">
          <Setter Property="Width" Value="38"/>
          <Setter Property="Height" Value="32"/>
          <Setter Property="Padding" Value="0"/>
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="BorderThickness" Value="0"/>
          <Setter Property="CornerRadius" Value="4"/>
          <Setter Property="HorizontalContentAlignment" Value="Center"/>
          <Setter Property="VerticalContentAlignment" Value="Center"/>
          <Setter Property="FocusAdorner" Value="{x:Null}"/>
        </Style>
        <Style Selector="Button.video-control:pointerover">
          <Setter Property="Background" Value="#304565"/>
        </Style>
        <Style Selector="Path.video-control-icon">
          <Setter Property="Width" Value="21"/>
          <Setter Property="Height" Value="21"/>
          <Setter Property="Stretch" Value="Uniform"/>
          <Setter Property="Fill" Value="Transparent"/>
          <Setter Property="Stroke" Value="#e7eef9"/>
          <Setter Property="StrokeThickness" Value="1.8"/>
          <Setter Property="StrokeLineCap" Value="Round"/>
          <Setter Property="StrokeJoin" Value="Round"/>
        </Style>
        <Style Selector="Path.video-control-icon.volume-control-icon">
          <Setter Property="Stroke" Value="#8fa1c0"/>
        </Style>
        <Style Selector="Button.video-control:pointerover Path.video-control-icon">
          <Setter Property="Stroke" Value="#71bdff"/>
        </Style>
      </Border.Styles>
      <Grid Margin="14,8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">
          <Button Grid.Column="0" Classes="video-control"
                  Command="{Binding TogglePlaybackCommand}"
                  AutomationProperties.Name="{Binding PlayPauseLabel}"
                  ToolTip.Tip="{Binding PlayPauseLabel}">
            <Grid>
              <Path Classes="video-control-icon"
                    IsVisible="{Binding !IsPlaying}"
                    Data="M 8,5 L 19,12 L 8,19 Z"/>
              <Path Classes="video-control-icon"
                    IsVisible="{Binding IsPlaying}"
                    Data="M 8,5 L 8,19 M 16,5 L 16,19"/>
            </Grid>
          </Button>
          <TextBlock Grid.Column="1"
                     Text="{Binding CurrentTimeLabel}"
                     Foreground="#b3c1dd" FontSize="11"
                     Margin="10,0" VerticalAlignment="Center"/>
          <Slider x:Name="TimelineSlider"
                  Grid.Column="2"
                  Minimum="0" Maximum="1"
                  Value="{Binding PlaybackPosition, Mode=TwoWay}"
                  VerticalAlignment="Center"/>
          <TextBlock Grid.Column="3"
                     Text="{Binding DurationLabel}"
                     Foreground="#b3c1dd" FontSize="11"
                     Margin="10,0" VerticalAlignment="Center"/>
          <Button Grid.Column="4" Classes="video-control"
                  Command="{Binding ToggleMuteCommand}"
                  AutomationProperties.Name="{Binding MuteLabel}"
                  ToolTip.Tip="{Binding MuteLabel}">
            <Grid>
              <Path Classes="video-control-icon volume-control-icon"
                    IsVisible="{Binding !IsMuted}"
                    Data="M 4,10 L 8,10 L 13,6 L 13,18 L 8,14 L 4,14 Z M 16,9 C 18,11 18,13 16,15 M 18.5,6.5 C 22,9.5 22,14.5 18.5,17.5"/>
              <Path Classes="video-control-icon volume-control-icon"
                    IsVisible="{Binding IsMuted}"
                    Data="M 4,10 L 8,10 L 13,6 L 13,18 L 8,14 L 4,14 Z M 17,9 L 22,14 M 22,9 L 17,14"/>
            </Grid>
          </Button>
          <Slider Grid.Column="5"
                  Minimum="0" Maximum="100" Width="92"
                  Value="{Binding Volume, Mode=TwoWay}"
                  Margin="8,0,0,0" VerticalAlignment="Center"/>
        </Grid>
        <TextBlock Grid.Row="1"
                   Text="{Binding StatusText}"
                   Foreground="#8fa1c0" FontSize="11"
                   Margin="0,6,0,0"
                   TextTrimming="CharacterEllipsis"/>
      </Grid>
    </Border>

    <Border x:Name="ScrubPreviewPopup"
            Width="208"
            Height="121"
            Margin="8,0,0,84"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Background="#fa0a1226"
            BorderBrush="#526889"
            BorderThickness="1"
            CornerRadius="6"
            Padding="4"
            IsVisible="{Binding IsScrubPreviewVisible}"
            IsHitTestVisible="False">
      <Grid Width="198" Height="111">
        <Border Background="#ff050810" CornerRadius="3"/>
        <Image Source="{Binding ScrubPreviewBitmap}"
               Stretch="Uniform"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"/>
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,4"
                Padding="7,2"
                Background="#d9000000"
                CornerRadius="3">
          <TextBlock Text="{Binding ScrubPreviewTimeLabel}"
                     Foreground="#f2f6fc"
                     FontSize="11"
                     FontWeight="SemiBold"/>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
