<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ImageViewer.Views.FileDeleteConfirmationDialog"
        x:CompileBindings="False"
        Title="Delete selected items"
        Icon="/Assets/ImageViewer.png"
        Width="560" Height="360"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#0f1729">
  <Grid RowDefinitions="Auto,*,Auto" Margin="24" RowSpacing="16">
    <StackPanel Spacing="5">
      <TextBlock x:Name="HeadingText" Foreground="#f3f7ff"
                 FontSize="19" FontWeight="SemiBold"/>
      <TextBlock Text="The selected files and folders will be moved to the Windows Recycle Bin."
                 Foreground="#e8c786" FontSize="12"/>
    </StackPanel>
    <Border Grid.Row="1" Background="#162038" CornerRadius="6" Padding="12">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="FileListText" Foreground="#b3c1dd"
                   FontSize="11" TextWrapping="Wrap"/>
      </ScrollViewer>
    </Border>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Cancel" Click="OnCancel" Padding="18,6"/>
      <Button Content="Move to Recycle Bin" Click="OnConfirm" Padding="18,6"/>
    </StackPanel>
  </Grid>
</Window>
