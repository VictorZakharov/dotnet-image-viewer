<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:ImageViewer.Views"
        x:Class="ImageViewer.Views.BatchToolsWindow"
        x:CompileBindings="True"
        Title="Batch tools"
        Icon="/Assets/ImageViewer.png"
        Width="1180" Height="790"
        MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="#0f1729">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Background="#1a2440" Padding="20,14"
            BorderBrush="#2a3858" BorderThickness="0,0,0,1">
      <StackPanel Spacing="3">
        <TextBlock Text="Preview-first batch tools" Foreground="#f3f7ff"
                   FontSize="22" FontWeight="SemiBold"/>
        <TextBlock x:Name="SourceSummaryText" Foreground="#8fb8eb" FontSize="12"/>
      </StackPanel>
    </Border>

    <TabControl Grid.Row="1" Margin="14">
      <TabItem Header="Rename">
        <views:BatchRenameView x:Name="RenamePanel"/>
      </TabItem>
      <TabItem Header="Image processing">
        <views:BatchProcessView x:Name="ProcessPanel"/>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" Background="#121c32" Padding="14,10"
            BorderBrush="#243049" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Close" Click="OnClose" Padding="22,7"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
