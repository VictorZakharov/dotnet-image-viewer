<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ImageViewer.ViewModels"
             xmlns:views="using:ImageViewer.Views"
             xmlns:models="using:ImageViewer.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="ImageViewer.Views.BrowserView"
             x:DataType="vm:BrowserViewModel"
             x:Name="Root"
             Background="#0f1729">

  <DockPanel>
    <!-- Toolbar (full-width) -->
    <Border DockPanel.Dock="Top" Background="#1a2440" Height="44">
      <Grid Margin="14,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="Open folder..." Click="OnOpenFolderClicked" Padding="12,4"/>

          <!-- Path: clickable display vs. editable TextBox -->
          <Grid IsVisible="{Binding HasFolder}" VerticalAlignment="Center" MinWidth="160">
            <Border IsVisible="{Binding !IsEditingPath}"
                    Background="Transparent"
                    CornerRadius="3"
                    Padding="6,3"
                    Cursor="Hand"
                    PointerPressed="OnPathClicked"
                    ToolTip.Tip="Click to edit path">
              <Border.Styles>
                <Style Selector="Border:pointerover">
                  <Setter Property="Background" Value="#243049"/>
                </Style>
              </Border.Styles>
              <TextBlock Text="{Binding CurrentFolder}"
                         Foreground="#b3c1dd" FontSize="12"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"
                         MaxWidth="520"/>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="8"
                        IsVisible="{Binding IsEditingPath}"
                        VerticalAlignment="Center">
              <TextBox x:Name="PathEditBox"
                       Text="{Binding PathEditText, Mode=TwoWay}"
                       FontSize="12" Padding="6,2" MinHeight="0" MinWidth="380"
                       KeyDown="OnPathEditKeyDown"
                       LostFocus="OnPathEditLostFocus"
                       AttachedToVisualTree="OnPathEditAttached"/>
              <TextBlock Text="{Binding PathEditErrorMessage}"
                         Foreground="#ff8a8a" FontSize="11"
                         VerticalAlignment="Center"
                         IsVisible="{Binding PathEditHasError}"/>
            </StackPanel>
          </Grid>

          <TextBlock Text="·" Foreground="#445573" VerticalAlignment="Center"
                     IsVisible="{Binding HasFolder}"/>
          <TextBlock Text="{Binding ItemsSummary}" Foreground="#8fa1c0" FontSize="12"
                     VerticalAlignment="Center"
                     IsVisible="{Binding HasFolder}"/>
          <Border Width="1" Height="20" Background="#2a3858" Margin="6,0"
                  IsVisible="{Binding HasFilter}"/>
          <TextBlock Text="Filter:" Foreground="#8fa1c0" FontSize="12"
                     VerticalAlignment="Center"
                     IsVisible="{Binding HasFilter}"/>
          <Border Background="#0a0f1c" Padding="8,3" CornerRadius="3"
                  IsVisible="{Binding HasFilter}">
            <TextBlock Text="{Binding FilterText}" Foreground="#e7eef9" FontSize="12"/>
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                    VerticalAlignment="Center">
          <Button Content="Explorer..."
                  AutomationProperties.Name="Windows and Explorer integration"
                  ToolTip.Tip="Windows file associations and Explorer integration"
                  Click="OnWindowsIntegrationClicked"
                  Padding="10,4"/>
          <StackPanel Orientation="Horizontal" Spacing="6"
                      IsVisible="{Binding HasFolder}">
            <ToggleButton Content="Smooth"
                          AutomationProperties.Name="Smooth scrolling"
                          IsChecked="{Binding SmoothScrollingEnabled, Mode=TwoWay}"
                          IsEnabled="{Binding SystemAnimationsEnabled}"
                          ToolTip.Tip="{Binding SmoothScrollingToolTip}"
                          Padding="10,4"/>
            <Button Content="{Binding SortLabelName}" Command="{Binding SortByNameCommand}" Padding="12,4"/>
            <Button Content="{Binding SortLabelDate}" Command="{Binding SortByDateCommand}" Padding="12,4"/>
            <Button Content="{Binding SortLabelSize}" Command="{Binding SortBySizeCommand}" Padding="12,4"/>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Body: tree pane | splitter | thumbnails | EXIF pane (right, optional) -->
    <DockPanel>
      <views:BrowserPropertiesPane DockPanel.Dock="Right"/>

      <!-- Tree pane | Splitter | Content -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="240" MinWidth="160"/>
          <ColumnDefinition Width="4"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Folder tree -->
        <Border Grid.Column="0" Background="#131c33">
          <TreeView x:Name="FolderTree"
                    AutomationProperties.Name="Folder tree"
                    AutomationProperties.AutomationId="FolderTree"
                    ItemsSource="{Binding DriveTree}"
                    SelectedItem="{Binding SelectedTreeItem, Mode=TwoWay}"
                    ScrollViewer.IsScrollInertiaEnabled="{Binding IsSmoothScrollingActive}"
                    Background="Transparent"
                    BorderThickness="0"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    Padding="2">
            <TreeView.Styles>
              <Style Selector="TreeViewItem" x:DataType="vm:FolderTreeItem">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                <Setter Property="MinHeight" Value="28"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
              </Style>
            </TreeView.Styles>
            <TreeView.ItemTemplate>
              <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="vm:FolderTreeItem">
                <TextBlock Text="{Binding Name}"
                           FontSize="16" Padding="1,0"
                           TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding Name}"/>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </Border>

        <GridSplitter Grid.Column="1"
                      Background="#0f1729"
                      ResizeDirection="Columns"
                      HorizontalAlignment="Stretch"/>

        <!-- Thumbnail grid + empty state -->
        <Grid Grid.Column="2">
          <ScrollViewer x:Name="ThumbScroll"
                        AutomationProperties.Name="Media scroller"
                        AutomationProperties.AutomationId="MediaScroller"
                        IsVisible="{Binding !ShowEmptyState}"
                        IsScrollInertiaEnabled="{Binding IsSmoothScrollingActive}"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        Background="Transparent">
            <ItemsRepeater x:Name="ThumbRepeater"
                           AutomationProperties.Name="Media grid"
                           ItemsSource="{Binding FilteredItems}"
                           DoubleTapped="OnThumbDoubleTapped"
                           Focusable="True"
                           HorizontalAlignment="Left"
                           VerticalCacheLength="0.75">
              <ItemsRepeater.Layout>
                <!-- Horizontal item flow wraps into rows on a vertical scroll axis. -->
                <UniformGridLayout
                    MinItemWidth="{Binding #Root.DataContext.ThumbnailCellWidth}"
                    MinItemHeight="{Binding #Root.DataContext.ThumbnailCellHeight}"
                    MinColumnSpacing="0"
                    MinRowSpacing="0"
                    ItemsJustification="Start"
                    ItemsStretch="None"
                    Orientation="Horizontal"/>
              </ItemsRepeater.Layout>
              <ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="vm:ThumbnailItem">
                <Border Width="{Binding #Root.DataContext.ThumbnailWidth}"
                        Height="{Binding #Root.DataContext.ThumbnailHeight}"
                        Margin="2"
                        Background="#1a2440"
                        BorderBrush="Transparent"
                        BorderThickness="1"
                        CornerRadius="4"
                        Classes.selected="{Binding IsSelected}"
                        PointerPressed="OnThumbnailPressed">
                  <Border.Styles>
                    <Style Selector="Border:pointerover">
                      <Setter Property="Background" Value="#243049"/>
                    </Style>
                    <Style Selector="Border.selected">
                      <Setter Property="Background" Value="#29496f"/>
                      <Setter Property="BorderBrush" Value="#67b7ff"/>
                      <Setter Property="BorderThickness" Value="3"/>
                    </Style>
                  </Border.Styles>
                  <Border.ContextFlyout>
                    <MenuFlyout>
                      <MenuItem Header="Properties"
                                Click="OnThumbPropertiesClicked"
                                IsVisible="{Binding IsFile}"/>
                    </MenuFlyout>
                  </Border.ContextFlyout>
                  <Grid>
                    <DockPanel>
                      <Grid DockPanel.Dock="Bottom" Margin="5,1,5,3">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                          <TextBlock Text="{Binding FileName}"
                                     Foreground="#dde6f5"
                                     FontSize="11"
                                     TextTrimming="CharacterEllipsis"
                                     HorizontalAlignment="Left"
                                     Cursor="Hand"
                                     PointerPressed="OnThumbnailTitlePressed"
                                     IsVisible="{Binding ShowFileTitle}"/>
                          <TextBlock Text="{Binding FileName}"
                                     Foreground="#e8c786"
                                     FontSize="11"
                                     FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis"
                                     HorizontalAlignment="Left"
                                     IsVisible="{Binding IsFolder}"/>
                          <TextBox Text="{Binding RenameText, Mode=TwoWay}"
                                   FontSize="11"
                                   Padding="3,1"
                                   MinHeight="0"
                                   IsVisible="{Binding IsRenaming}"
                                   LostFocus="OnRenameLostFocus"
                                   AttachedToVisualTree="OnRenameTextBoxAttached"/>
                        </Grid>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding DateLabel}"
                                   ToolTip.Tip="{Binding DateToolTip}"
                                   Foreground="#7f91af"
                                   FontSize="9"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"/>
                      </Grid>
                      <Grid Margin="3,3,3,1">
                        <Border Background="#070b16"
                                IsVisible="{Binding IsFile}">
                          <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                        </Border>
                        <Border Width="42" Height="42"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#b30a1226"
                                BorderBrush="#dde6f5"
                                BorderThickness="1"
                                CornerRadius="21"
                                IsHitTestVisible="False"
                                IsVisible="{Binding IsVideo}">
                          <TextBlock Text="&#x25B6;"
                                     Foreground="#ffffff"
                                     FontSize="18"
                                     Margin="3,0,0,0"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                        </Border>
                        <Border Background="#111a2d"
                                BorderBrush="#9b753d"
                                BorderThickness="1"
                                CornerRadius="3"
                                IsVisible="{Binding IsFolder}">
                          <Grid Margin="3">
                            <ItemsControl ItemsSource="{Binding FolderPreviewSlots}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <UniformGrid Rows="2" Columns="2"/>
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FolderPreviewSlot">
                                  <Border Background="#070b16"
                                          Margin="1"
                                          CornerRadius="2"
                                          ClipToBounds="True">
                                    <Grid>
                                      <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                      <TextBlock Text="&#x25B6;"
                                                 Foreground="White"
                                                 FontSize="12"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 IsVisible="{Binding IsVideo}"/>
                                    </Grid>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Background="#80070b16"
                                     IsHitTestVisible="False"
                                     IsVisible="{Binding IsFolderPreviewLoading}">
                              <Path Width="28" Height="28"
                                    AutomationProperties.Name="Loading folder previews"
                                    Data="M 14,2 A 12,12 0 1 1 5.5,5.5"
                                    Fill="Transparent"
                                    Stroke="#e0a060"
                                    StrokeThickness="3"
                                    StrokeLineCap="Round"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    RenderTransformOrigin="50%,50%">
                                <Path.RenderTransform>
                                  <RotateTransform/>
                                </Path.RenderTransform>
                                <Path.Styles>
                                  <Style Selector="Path">
                                    <Style.Animations>
                                      <Animation Duration="0:0:0.8" IterationCount="INFINITE">
                                        <KeyFrame Cue="0%">
                                          <Setter Property="RotateTransform.Angle" Value="0"/>
                                        </KeyFrame>
                                        <KeyFrame Cue="100%">
                                          <Setter Property="RotateTransform.Angle" Value="360"/>
                                        </KeyFrame>
                                      </Animation>
                                    </Style.Animations>
                                  </Style>
                                </Path.Styles>
                              </Path>
                            </Border>
                          </Grid>
                        </Border>
                      </Grid>
                    </DockPanel>
                    <!-- Folder badge -->
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="8,8,0,0"
                            Background="#e0a060"
                            CornerRadius="3"
                            Padding="6,2"
                            IsHitTestVisible="False"
                            IsVisible="{Binding IsFolder}">
                      <TextBlock Text="FOLDER"
                                 FontSize="9"
                                 FontWeight="Bold"
                                 Foreground="#1a2030"/>
                    </Border>
                    <!-- Extension pill -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,8,8,0"
                            Background="#cc0a1226"
                            BorderBrush="{Binding ExtensionBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="6,2"
                            IsHitTestVisible="False"
                            IsVisible="{Binding ShowFileTitle}">
                      <TextBlock Text="{Binding ExtensionLabel}"
                                 FontSize="9"
                                 FontWeight="SemiBold"
                                 Foreground="{Binding ExtensionBrush}"/>
                    </Border>
                    <Border Width="24" Height="24"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,8,26"
                            Background="#67b7ff"
                            BorderBrush="#f4f9ff"
                            BorderThickness="1"
                            CornerRadius="12"
                            IsHitTestVisible="False"
                            IsVisible="{Binding IsSelected}">
                      <TextBlock Text="&#x2713;"
                                 Foreground="#07101f"
                                 FontSize="14"
                                 FontWeight="Bold"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                    </Border>
                  </Grid>
                </Border>
              </DataTemplate>
              </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
          </ScrollViewer>

          <Panel IsVisible="{Binding ShowEmptyState}" Background="#0f1729">
            <StackPanel Spacing="14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="40">
              <TextBlock Text="No media to show"
                         FontSize="20" Foreground="#8fa1c0"
                         HorizontalAlignment="Center"/>
              <TextBlock Text="{Binding EmptyStateHint}"
                         FontSize="13" Foreground="#5f7494"
                         HorizontalAlignment="Center"
                         TextWrapping="Wrap" TextAlignment="Center"
                         MaxWidth="420"/>
              <Button Content="Open folder..."
                      Click="OnOpenFolderClicked"
                      HorizontalAlignment="Center"
                      Padding="24,8"
                      Margin="0,12,0,0"
                      FontSize="13"/>
              <TextBlock FontSize="11" Foreground="#445573"
                         HorizontalAlignment="Center" TextAlignment="Center"
                         TextWrapping="Wrap" MaxWidth="420">
                Tip: pick a folder from the tree on the left, drag one onto the window, or press Ctrl+O.
              </TextBlock>
            </StackPanel>
          </Panel>
          <ProgressBar IsIndeterminate="True"
                       AutomationProperties.Name="Loading images"
                       IsVisible="{Binding IsGridLoading}"
                       Height="3"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Top"/>
          <Border Background="#d90a1226"
                  AutomationProperties.Name="{Binding GridDiagnostics}"
                  BorderBrush="#445573"
                  BorderThickness="1"
                  CornerRadius="3"
                  Padding="7,3"
                  Margin="8"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  IsHitTestVisible="False"
                  IsVisible="{Binding ShowGridDiagnostics}">
            <TextBlock Text="{Binding GridDiagnostics}"
                       FontFamily="Consolas"
                       FontSize="10"
                       Foreground="#b3c1dd"/>
          </Border>
        </Grid>
      </Grid>
    </DockPanel>
  </DockPanel>
</UserControl>
