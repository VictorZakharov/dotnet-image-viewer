<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ImageViewer.ViewModels"
             xmlns:controls="using:ImageViewer.Controls"
             xmlns:models="using:ImageViewer.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="ImageViewer.Views.ViewerView"
             x:DataType="vm:ViewerViewModel"
             Focusable="True"
             FocusAdorner="{x:Null}"
             Background="#070b16">

  <Grid>
    <Grid IsVisible="{Binding IsImage}">
      <controls:ZoomPanImage x:Name="ViewerImage"
                             Source="{Binding Bitmap}"
                             Rotation="{Binding Rotation}"
                             FocusAdorner="{x:Null}"
                             IsVisible="{Binding !IsImageLoading}"/>

      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="10"
                  IsHitTestVisible="False"
                  IsVisible="{Binding IsImageLoading}">
        <ProgressBar IsIndeterminate="True" Width="140" Height="4"/>
        <TextBlock Text="Loading image..."
                   HorizontalAlignment="Center"
                   Foreground="#8fa1c0"
                   FontSize="12"/>
      </StackPanel>
      <controls:CropSelectionOverlay x:Name="CropOverlay"
                                     IsVisible="{Binding IsCropping}"
                                     SelectionChanged="OnCropSelectionChanged"/>
    </Grid>

    <!-- Compact image tools stay discoverable without taking canvas space.
         Fullscreen is presentation-only, so the rail disappears there. -->
    <Border HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Margin="12,0,0,32"
            Padding="5"
            Background="#e6121c32"
            BorderBrush="#344665"
            BorderThickness="1"
            CornerRadius="7"
            IsVisible="{Binding ShowImageTools}">
      <Border.Styles>
        <Style Selector="Button.viewer-tool">
          <Setter Property="Width" Value="42"/>
          <Setter Property="Height" Value="42"/>
          <Setter Property="Padding" Value="0"/>
          <Setter Property="FontSize" Value="19"/>
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="BorderThickness" Value="0"/>
          <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Button.viewer-tool:pointerover">
          <Setter Property="Background" Value="#304565"/>
        </Style>
        <Style Selector="Path.viewer-tool-icon">
          <Setter Property="Width" Value="21"/>
          <Setter Property="Height" Value="21"/>
          <Setter Property="Stretch" Value="Uniform"/>
          <Setter Property="Fill" Value="Transparent"/>
          <Setter Property="Stroke" Value="#e7eef9"/>
          <Setter Property="StrokeThickness" Value="1.8"/>
          <Setter Property="StrokeLineCap" Value="Round"/>
          <Setter Property="StrokeJoin" Value="Round"/>
        </Style>
        <Style Selector="Button.viewer-tool:pointerover Path.viewer-tool-icon">
          <Setter Property="Stroke" Value="#71bdff"/>
        </Style>
      </Border.Styles>
      <StackPanel Spacing="3">
        <Button Classes="viewer-tool"
                Command="{Binding RotateLeftCommand}"
                AutomationProperties.Name="Rotate left 90 degrees"
                ToolTip.Tip="Rotate left 90°">
          <Path Classes="viewer-tool-icon"
                Data="M 8,7 L 4,7 L 4,3 M 4,7 C 6,4.5 8.7,3 12,3 C 17,3 21,7 21,12 C 21,17 17,21 12,21 C 8.4,21 5.2,19 3.7,16"/>
        </Button>
        <Button Classes="viewer-tool"
                Command="{Binding RotateRightCommand}"
                AutomationProperties.Name="Rotate right 90 degrees"
                ToolTip.Tip="Rotate right 90°">
          <Path Classes="viewer-tool-icon"
                Data="M 16,7 L 20,7 L 20,3 M 20,7 C 18,4.5 15.3,3 12,3 C 7,3 3,7 3,12 C 3,17 7,21 12,21 C 15.6,21 18.8,19 20.3,16"/>
        </Button>
        <Border Height="1" Background="#344665" Margin="4,2"/>
        <Button Classes="viewer-tool" Tag="Resize"
                Click="OnEditImageClicked"
                AutomationProperties.Name="Resize image"
                ToolTip.Tip="Resize image…">
          <Path Classes="viewer-tool-icon"
                Data="M 10,4 L 4,4 L 4,10 M 4,4 L 10,10 M 14,20 L 20,20 L 20,14 M 20,20 L 14,14"/>
        </Button>
        <Button Classes="viewer-tool"
                Click="OnCropToolClicked"
                AutomationProperties.Name="Crop image"
                ToolTip.Tip="Select an area to crop">
          <Path Classes="viewer-tool-icon"
                Data="M 5,3 L 5,17 C 5,18.1 5.9,19 7,19 L 21,19 M 3,5 L 17,5 C 18.1,5 19,5.9 19,7 L 19,21"/>
        </Button>
        <Button Classes="viewer-tool" Tag="Convert"
                Click="OnEditImageClicked"
                AutomationProperties.Name="Convert image format"
                ToolTip.Tip="Convert image format…">
          <Path Classes="viewer-tool-icon"
                Data="M 4,7 L 18,7 M 15,4 L 18,7 L 15,10 M 20,17 L 6,17 M 9,14 L 6,17 L 9,20"/>
        </Button>
        <Button Classes="viewer-tool" Tag="Watermark"
                Click="OnEditImageClicked"
                AutomationProperties.Name="Add text watermark"
                ToolTip.Tip="Add text watermark…">
          <Path Classes="viewer-tool-icon"
                Data="M 3,5 L 15,5 M 9,5 L 9,19 M 5.5,19 L 12.5,19 M 18.5,10 C 18.5,10 15.5,14.1 15.5,16.4 C 15.5,18.2 16.8,19.5 18.5,19.5 C 20.2,19.5 21.5,18.2 21.5,16.4 C 21.5,14.1 18.5,10 18.5,10 Z"/>
        </Button>
        <Button Classes="viewer-tool" Tag="RemoveMetadata"
                Click="OnEditImageClicked"
                AutomationProperties.Name="Remove image metadata"
                ToolTip.Tip="Remove image metadata…">
          <Path Classes="viewer-tool-icon"
                Data="M 3,12 L 11.5,3.5 L 20,3.5 L 20,12 L 11.5,20.5 Z M 16.5,7.5 L 16.6,7.5 M 4,4 L 20,20"/>
        </Button>
        <Border Height="1" Background="#344665" Margin="4,2"/>
        <Button Classes="viewer-tool"
                Click="OnPropertiesClicked"
                AutomationProperties.Name="Show image properties"
                ToolTip.Tip="Show image properties">
          <Path Classes="viewer-tool-icon"
                Data="M 12,3 A 9,9 0 1 0 12,21 A 9,9 0 1 0 12,3 M 12,11 L 12,17 M 12,7 L 12,7.1"/>
        </Button>
      </StackPanel>
    </Border>

    <Border HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,48"
            Padding="12,8"
            Background="#ed121c32"
            BorderBrush="#45a9ff"
            BorderThickness="1"
            CornerRadius="6"
            IsVisible="{Binding IsCropping}">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Text="Crop" Foreground="#f3f7ff" FontWeight="SemiBold"
                   VerticalAlignment="Center"/>
        <TextBlock x:Name="CropSelectionText" Foreground="#9fc9ef"
                   VerticalAlignment="Center"/>
        <TextBlock Text="Drag edges or draw a new area"
                   Foreground="#7185a5" FontSize="10" VerticalAlignment="Center"/>
        <Button Content="Full image" Click="OnResetCropClicked" Padding="10,4"/>
        <Button Content="Cancel" Click="OnCancelCropClicked" Padding="10,4"/>
        <Button Content="Apply crop" Click="OnApplyCropClicked" Padding="12,4"/>
      </StackPanel>
    </Border>

    <!-- Created in code only after the first video opens. Keeping this host
         empty for images prevents native VLC initialization on startup. -->
    <ContentControl x:Name="VideoHost"
                    Background="#000000"
                    IsVisible="{Binding IsVideo}"/>

    <!-- Status bar -->
    <Border Background="#cc0a1226"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            Height="32"
            IsVisible="{Binding IsImage}"
            IsHitTestVisible="False">
      <Grid Margin="14,0">
        <TextBlock Text="{Binding StatusText}"
                   Foreground="#dde6f5"
                   VerticalAlignment="Center"
                   FontSize="12"/>
        <TextBlock Text="{Binding SlideshowStatus}"
                   Foreground="#b3c1dd"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   FontSize="12"/>
      </Grid>
    </Border>

    <!-- EXIF overlay -->
    <Border IsVisible="{Binding ShowImageInfoOverlay}"
            Background="#ee0e1830"
            Width="320"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            Padding="22,56,22,48">
      <ScrollViewer>
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding FileNameDisplay}"
                     Foreground="#e7eef9" FontSize="14" FontWeight="SemiBold"
                     TextWrapping="Wrap"/>
          <TextBlock Text="{Binding FolderDisplay}"
                     Foreground="#8fa1c0" FontSize="11"
                     TextWrapping="Wrap"/>

          <Border Height="1" Background="#2a3858" Margin="0,10"/>

          <Grid IsVisible="{Binding Metadata.DimensionsSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="Dimensions" Foreground="#8fa1c0" FontSize="11" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Metadata.DimensionsSummary}"
                       Foreground="#dde6f5" FontSize="12" HorizontalAlignment="Right"/>
          </Grid>
          <Grid IsVisible="{Binding Metadata.FileSizeSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="Size" Foreground="#8fa1c0" FontSize="11" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Metadata.FileSizeSummary}"
                       Foreground="#dde6f5" FontSize="12" HorizontalAlignment="Right"/>
          </Grid>
          <Grid IsVisible="{Binding Metadata.FileCreatedAtSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="Created" Foreground="#8fa1c0" FontSize="11" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Metadata.FileCreatedAtSummary}"
                       Foreground="#dde6f5" FontSize="11" HorizontalAlignment="Right"/>
          </Grid>
          <Grid IsVisible="{Binding Metadata.FileModifiedAtSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="Modified" Foreground="#8fa1c0" FontSize="11" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Metadata.FileModifiedAtSummary}"
                       Foreground="#dde6f5" FontSize="11" HorizontalAlignment="Right"/>
          </Grid>
          <Grid IsVisible="{Binding Metadata.FileAccessedAtSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="Accessed" Foreground="#8fa1c0" FontSize="11" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Metadata.FileAccessedAtSummary}"
                       Foreground="#dde6f5" FontSize="11" HorizontalAlignment="Right"/>
          </Grid>

          <Border Height="1" Background="#2a3858" Margin="0,10"
                  IsVisible="{Binding HasAnyExifData}"/>

          <StackPanel Spacing="4" IsVisible="{Binding HasAnyExifData}">
            <TextBlock Text="{Binding Metadata.CameraSummary}"
                       Foreground="#dde6f5" FontSize="13" FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       IsVisible="{Binding Metadata.CameraSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock Text="{Binding Metadata.Lens}"
                       Foreground="#b3c1dd" FontSize="11"
                       TextWrapping="Wrap"
                       IsVisible="{Binding Metadata.Lens, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock Text="{Binding Metadata.ExposureSummary}"
                       Foreground="#dde6f5" FontSize="12" Margin="0,4,0,0"
                       IsVisible="{Binding Metadata.ExposureSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <Grid IsVisible="{Binding Metadata.TakenAtSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Text="Date taken" Foreground="#8fa1c0" FontSize="11" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding Metadata.TakenAtSummary}"
                         Foreground="#dde6f5" FontSize="11" HorizontalAlignment="Right"/>
            </Grid>
          </StackPanel>

          <TextBlock Text="No camera metadata"
                     Foreground="#5f7494" FontSize="11" FontStyle="Italic"
                     Margin="0,8,0,0"
                     IsVisible="{Binding !HasAnyExifData}"/>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- EXIF pill toggle (top-right, last child so it's on top of overlay) -->
    <Border HorizontalAlignment="Right" VerticalAlignment="Top"
            Margin="0,14,14,0"
            Classes.active="{Binding ShowExifOverlay}"
            BorderThickness="1"
            CornerRadius="3"
            Padding="10,4"
            Cursor="Hand"
            IsVisible="{Binding IsImage}"
            PointerPressed="OnExifPillClicked">
      <Border.Styles>
        <Style Selector="Border">
          <Setter Property="Background" Value="#cc0a1226"/>
          <Setter Property="BorderBrush" Value="#445573"/>
        </Style>
        <Style Selector="Border.active">
          <Setter Property="Background" Value="#cc1a2c4a"/>
          <Setter Property="BorderBrush" Value="#5bc78a"/>
        </Style>
        <Style Selector="Border.active TextBlock">
          <Setter Property="Foreground" Value="#5bc78a"/>
        </Style>
      </Border.Styles>
      <TextBlock Text="{Binding InfoPanelLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#b3c1dd"/>
    </Border>
  </Grid>
</UserControl>
