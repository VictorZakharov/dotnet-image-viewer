<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsWindowsBuild Condition="'$(RuntimeIdentifier)' == 'win-x64' or '$(RuntimeIdentifier)' == 'win-x86' or '$(RuntimeIdentifier)' == 'win-arm64' or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows')))">true</IsWindowsBuild>
    <IsLinuxBuild Condition="'$(RuntimeIdentifier)' == 'linux-x64' or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux')))">true</IsLinuxBuild>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- The AOT-safe Windows shell thumbnail bridge calls one fixed COM vtable. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <ApplicationManifest Condition="'$(IsWindowsBuild)' == 'true'">app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>ImageViewer</RootNamespace>
    <AssemblyName>ImageViewer</AssemblyName>
    <ApplicationIcon Condition="'$(IsWindowsBuild)' == 'true'">Assets\ImageViewer.ico</ApplicationIcon>
    <AssemblyTitle>ImageViewer</AssemblyTitle>
    <Product>ImageViewer</Product>
    <Version>0.1.0</Version>
    <Description>A lightweight image and video viewer for Windows and Linux</Description>
    <Authors>Victor Zakharov</Authors>
    <Company>Victor Zakharov</Company>
    <Copyright>Copyright © 2026 Victor Zakharov</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/VictorZakharov/dotnet-image-viewer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>

  <!-- Keep audited dependency versions stable and reuse them for publish notices. -->
  <PropertyGroup>
    <CommunityToolkitVersion>8.4.2</CommunityToolkitVersion>
    <MagickNetVersion>14.16.0</MagickNetVersion>
    <MetadataExtractorVersion>2.9.3</MetadataExtractorVersion>
    <AngleNativeNoticeVersion>2.1.27548.20260419</AngleNativeNoticeVersion>
    <SkiaSharpNoticeVersion>3.119.4</SkiaSharpNoticeVersion>
    <HarfBuzzSharpNoticeVersion>8.3.1.3</HarfBuzzSharpNoticeVersion>
    <DotNetAotNoticeVersion>10.0.7</DotNetAotNoticeVersion>
  </PropertyGroup>

  <!-- A RID-specific Release publish is the fast-starting distribution build.
       Normal Debug/Release builds stay framework-dependent for quick iteration. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' and ('$(RuntimeIdentifier)' == 'win-x64' or '$(RuntimeIdentifier)' == 'linux-x64')">
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <!-- VideoLAN.LibVLC.Windows defaults AnyCPU builds to every Windows architecture.
       A RID-specific publish only needs the matching native runtime. -->
  <PropertyGroup Condition="'$(IsWindowsBuild)' == 'true' and '$(RuntimeIdentifier)' != ''">
    <VlcWindowsX64Enabled>false</VlcWindowsX64Enabled>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
    <VlcWindowsX64Enabled Condition="'$(RuntimeIdentifier)' == 'win-x64'">true</VlcWindowsX64Enabled>
    <VlcWindowsX86Enabled Condition="'$(RuntimeIdentifier)' == 'win-x86'">true</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled Condition="'$(RuntimeIdentifier)' == 'win-arm64'">true</VlcWindowsArm64Enabled>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE"
          Link="LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\THIRD-PARTY-NOTICES.md"
          Link="THIRD-PARTY-NOTICES.md"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\LICENSES\**\*"
          Link="LICENSES\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Preserve exact upstream notices beside distributed binaries. -->
  <ItemGroup Condition="'$(IsWindowsBuild)' == 'true'">
    <None Include="$(NuGetPackageRoot)avalonia.angle.windows.natives\$(AngleNativeNoticeVersion)\LICENSE"
          Link="LICENSES\Avalonia.Angle.Windows.Natives-LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)communitytoolkit.mvvm\$(CommunityToolkitVersion)\License.md"
          Link="LICENSES\CommunityToolkit.Mvvm-LICENSE.md"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)communitytoolkit.mvvm\$(CommunityToolkitVersion)\ThirdPartyNotices.txt"
          Link="LICENSES\CommunityToolkit.Mvvm-THIRD-PARTY-NOTICES.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)magick.net-q8-anycpu\$(MagickNetVersion)\Notice.txt"
          Link="LICENSES\Magick.NET-NOTICE.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)skiasharp.nativeassets.win32\$(SkiaSharpNoticeVersion)\LICENSE.txt"
          Link="LICENSES\SkiaSharp-LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)skiasharp.nativeassets.win32\$(SkiaSharpNoticeVersion)\THIRD-PARTY-NOTICES.txt"
          Link="LICENSES\SkiaSharp-THIRD-PARTY-NOTICES.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)harfbuzzsharp.nativeassets.win32\$(HarfBuzzSharpNoticeVersion)\LICENSE.txt"
          Link="LICENSES\HarfBuzzSharp-LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)harfbuzzsharp.nativeassets.win32\$(HarfBuzzSharpNoticeVersion)\THIRD-PARTY-NOTICES.txt"
          Link="LICENSES\HarfBuzzSharp-THIRD-PARTY-NOTICES.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsLinuxBuild)' == 'true'">
    <None Include="$(NuGetPackageRoot)communitytoolkit.mvvm\$(CommunityToolkitVersion)\License.md"
          Link="LICENSES\CommunityToolkit.Mvvm-LICENSE.md"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)communitytoolkit.mvvm\$(CommunityToolkitVersion)\ThirdPartyNotices.txt"
          Link="LICENSES\CommunityToolkit.Mvvm-THIRD-PARTY-NOTICES.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)magick.net-q8-anycpu\$(MagickNetVersion)\Notice.txt"
          Link="LICENSES\Magick.NET-NOTICE.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)skiasharp.nativeassets.linux\$(SkiaSharpNoticeVersion)\LICENSE.txt"
          Link="LICENSES\SkiaSharp-LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)skiasharp.nativeassets.linux\$(SkiaSharpNoticeVersion)\THIRD-PARTY-NOTICES.txt"
          Link="LICENSES\SkiaSharp-THIRD-PARTY-NOTICES.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)harfbuzzsharp.nativeassets.linux\$(HarfBuzzSharpNoticeVersion)\LICENSE.txt"
          Link="LICENSES\HarfBuzzSharp-LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)harfbuzzsharp.nativeassets.linux\$(HarfBuzzSharpNoticeVersion)\THIRD-PARTY-NOTICES.txt"
          Link="LICENSES\HarfBuzzSharp-THIRD-PARTY-NOTICES.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(NuGetPackageRoot)microsoft.dotnet.ilcompiler\$(DotNetAotNoticeVersion)\THIRD-PARTY-NOTICES.TXT"
          Link="LICENSES\.NET-NativeAOT-THIRD-PARTY-NOTICES.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Condition="Exists('$(NuGetPackageRoot)microsoft.dotnet.ilcompiler\$(DotNetAotNoticeVersion)\THIRD-PARTY-NOTICES.TXT')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="Avalonia.Controls.ItemsRepeater" Version="12.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="$(CommunityToolkitVersion)" />
    <PackageReference Include="LibVLCSharp.Avalonia" Version="3.10.0" />
    <PackageReference Include="MetadataExtractor" Version="$(MetadataExtractorVersion)" />
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="$(MagickNetVersion)" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1"
                      Condition="'$(IsWindowsBuild)' == 'true'" />
  </ItemGroup>

</Project>
