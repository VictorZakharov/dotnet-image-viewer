[Desktop Entry]
Version=1.0
Type=Application
Name=ImageViewer
GenericName=Image and Video Viewer
Comment=Browse, inspect, compare, and play local media
TryExec=imageviewer
Exec=imageviewer %f
Icon=imageviewer
Terminal=false
StartupNotify=true
StartupWMClass=ImageViewer
Categories=Graphics;Viewer;Photography;
MimeType=image/jpeg;image/png;image/gif;image/bmp;image/webp;image/tiff;image/vnd.microsoft.icon;image/x-nikon-nef;image/x-canon-cr2;image/x-canon-cr3;image/x-sony-arw;image/x-adobe-dng;image/x-fuji-raf;image/x-panasonic-rw2;image/x-olympus-orf;image/x-pentax-pef;image/x-samsung-srw;video/mp4;video/x-m4v;video/quicktime;video/x-msvideo;video/x-matroska;video/webm;video/x-ms-wmv;video/mpeg;video/mp2t;video/3gpp;video/3gpp2;video/ogg;
